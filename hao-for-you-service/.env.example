HOST=0.0.0.0
PORT=8080
DEBUG=false
ENV=prod
AGENT_STATE_VERSION=v1

# "ollama" (local dev, no AWS needed) or "bedrock" (Amazon Bedrock)
MODEL_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:4b
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

DATABASE_URL=

# Internal service-to-service HMAC auth (must match hao-for-you-gateway)
INTERNAL_API_SECRET=
INTERNAL_API_TIMESTAMP_WINDOW=300

SUMMARY_TRIGGER_MESSAGES=30
SUMMARY_KEEP_MESSAGES=20

LANGGRAPH_STRICT_MSGPACK=true
