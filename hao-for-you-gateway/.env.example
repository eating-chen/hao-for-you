# Server
PORT=8008

# Jasypt encryption key
JASYPT_ENCRYPTOR_PASSWORD=

# LINE Bot (fill in when needed)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Database (local PostgreSQL, not Docker)
DB_URL=jdbc:postgresql://localhost:5432/haoforyou
DB_USER=
DB_PASSWORD=

# Google OAuth (fill in when needed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Internal service-to-service HMAC auth (must match hao-for-you-service)
INTERNAL_API_SECRET=
INTERNAL_API_TIMESTAMP_WINDOW=300
